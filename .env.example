# =========================
# Application
# =========================
ENVIRONMENT=development
API_PORT=8000

# =========================
# PostgreSQL
# If app runs on host: localhost
# If app runs in docker-compose: postgres
# =========================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=self_checkout

# =========================
# RabbitMQ
# If app runs on host: localhost
# If app runs in docker-compose: rabbitmq
# =========================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_MANAGEMENT_PORT=15672

# =========================
# Redis
# If app runs on host: localhost
# If app runs in docker-compose: redis
# =========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =========================
# Auth / JWT
# =========================
SECRET_KEY=change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# =========================
# SMTP
# Default targets local SMTP catcher (Mailpit/MailHog)
# =========================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=dev@example.com
SMTP_PASSWORD=dev_password
EMAIL_FROM="Self Checkout <no-reply@example.com>"

# =========================
# Google
# =========================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# =========================
# Stripe
# =========================
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/checkout/success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/checkout/cancel
STRIPE_CURRENCY=chf
STRIPE_WEBHOOK_SECRET=whsec_replace_me
